{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Spend.Up",
    "version": "0.1.0",
    "identifier": "ch.spendup.app",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:5173",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Spend.Up",
                "width": 1280,
                "height": 800,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/henry.w@example.net", "icons/icon.icns", "icons/icon.ico"]
    },
    "plugins": {
        "deep-link": {
            "desktop": {
                "schemes": ["spendup"]
            }
        }
    }
}
