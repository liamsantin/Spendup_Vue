{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Spend.Up",
    "version": "0.1.0",
    "identifier": "ch.spendup.app",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:5173",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Spend.Up",
                "width": 1280,
                "height": 800,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": {
                "default-src": "'self' customprotocol: asset:",
                "img-src": "'self' asset: http://asset.localhost data: blob: https:",
                "font-src": "'self' https://fonts.gstatic.com data:",
                "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
                "script-src": "'self' https://accounts.google.com",
                "frame-src": "https://accounts.google.com",
                "connect-src": "'self' ipc: http://ipc.localhost https://accounts.google.com https://*.googleapis.com http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:* wss://localhost:* wss://127.0.0.1:*",
                "base-uri": "'self'",
                "form-action": "'self'",
                "object-src": "'none'",
                "frame-ancestors": "'self'"
            },
            "devCsp": {
                "default-src": "'self' customprotocol: asset:",
                "img-src": "'self' asset: http://asset.localhost data: blob: https:",
                "font-src": "'self' https://fonts.gstatic.com data:",
                "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
                "script-src": "'self' 'unsafe-inline' 'unsafe-eval' https://accounts.google.com",
                "frame-src": "https://accounts.google.com",
                "connect-src": "'self' ipc: http://ipc.localhost http: https: ws: wss:",
                "base-uri": "'self'",
                "form-action": "'self'",
                "object-src": "'none'",
                "frame-ancestors": "'self'"
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/henry.w@example.net", "icons/icon.icns", "icons/icon.ico"]
    },
    "plugins": {
        "deep-link": {
            "desktop": {
                "schemes": ["spendup"]
            }
        }
    }
}
