{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Default desktop capabilities for Spend.Up",
    "windows": ["main"],
    "permissions": [
        "core:default",
        "core:event:default",
        "opener:default",
        "deep-link:default",
        "notification:default",
        "allow-oauth-loopback-wait",
        "allow-oauth-loopback-cancel",
        "allow-google-exchange-code"
    ]
}
