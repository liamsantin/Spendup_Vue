# API Spendup (sans slash final)
VITE_API_BASE_URL=http://localhost:5124

# Affiche la page /tarifs quand true (ou 1)
VITE_PRICING_PAGE=false

# Même Client ID Web que Authentication:Google:ClientId côté API
# Copier la valeur dans .env (Vite ne charge pas .env.example)
VITE_GOOGLE_CLIENT_ID=

# Environnement applicatif : development | production
VITE_APP_ENV=development

# true = refresh via cookie HttpOnly (API P1) — plus de refresh en localStorage
VITE_AUTH_COOKIE_MODE=true
