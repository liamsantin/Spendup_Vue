# API Spendup (sans slash final)
VITE_API_BASE_URL=http://localhost:5124

# Affiche la page /tarifs quand true (ou 1)
VITE_PRICING_PAGE=false

# Même Client ID Web que Authentication:Google:ClientId côté API
# Copier la valeur dans .env (Vite ne charge pas .env.example)
VITE_GOOGLE_CLIENT_ID=

# Client OAuth Desktop (PKCE Tauri) — l’API doit aussi accepter cet `aud`
VITE_GOOGLE_DESKTOP_CLIENT_ID=

# Secret client Desktop Google — NATIF uniquement (jamais VITE_ : hors bundle JS).
# Lu par src-tauri/build.rs + runtime Rust. Alias VITE_ accepté en transition.
GOOGLE_DESKTOP_CLIENT_SECRET=
# VITE_GOOGLE_DESKTOP_CLIENT_SECRET=

# Environnement applicatif : development | production
VITE_APP_ENV=development

# false = Bearer (défaut / prod cross-site). true = cookies HttpOnly + CSRF (same-site only)
VITE_AUTH_COOKIE_MODE=false

# Production seulement : true atteste que l'API est servie sous le domaine du site (ex. api.monsite.ch).
# Sans lui, un build de production reste en Bearer même si VITE_AUTH_COOKIE_MODE=true.
# L'app de bureau reste toujours en Bearer.
VITE_AUTH_SAME_SITE_API=false

# Abonnement : false = API réelle /api/subscription ; sinon (ou absent) mock en mémoire tant que le backend n’existe pas
VITE_SUBSCRIPTION_MOCK=true

# Adresse de destination du formulaire de la page /contact (ouvre la messagerie via mailto:)
VITE_CONTACT_EMAIL=

# URL publique du site (sans slash final) : l'app Windows y ouvre les CGU et la politique de confidentialité
VITE_PUBLIC_SITE_URL=

# --- Cibles web (voir .env.landing / .env.demo / .env.app) ---
# VITE_TARGET=landing|demo|app ; absent = toutes les routes (dev local, application Windows)
VITE_TARGET=
VITE_LANDING_URL=
VITE_DEMO_URL=
VITE_APP_URL=
